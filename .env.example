# Copy this file to .env and fill in your own keys.
#   cp .env.example .env
# .env is gitignored — never commit real keys.

# ---- Required ----
# Used by nearly every lesson (Anthropic Claude API).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Required for the RAG / retrieval lessons ----
# src/context_engineering/04_rag_context_pipeline.py and 05_error_handling.py
# Get one at: https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# ---- Optional ----
# Not currently read by any lesson — set only if you swap in OpenAI embeddings.
OPENAI_API_KEY=

# ---- Optional tuning for ctx-engineering-part1/context_analyzer.py ----
# All have working defaults; override only if you want different behavior.
ANSWER_MODEL=claude-sonnet-4-5
JUDGE_MODEL=claude-sonnet-4-5
RUNS_PER_CONTEXT=3
PRICE_IN_PER_M=3.00
PRICE_OUT_PER_M=15.00
